# ── Server ──────────────────────────────────────
APP_ENV=development
PORT=8000

# ── MongoDB ─────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=joblens

# ── NLP ─────────────────────────────────────────
# Sentence-transformer model (cached locally after first download)
SBERT_MODEL=all-MiniLM-L6-v2

# Fit score weights (must sum to 1.0)
WEIGHT_KEYWORD=0.40
WEIGHT_SEMANTIC=0.40
WEIGHT_SENIORITY=0.20

# ── Optional: LLM for rewrite suggestions ───────
# Leave blank to use rule-based fallback
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
